# Copy to .env (or set these in your hosting dashboard). Everything is optional
# for local development.

# --- basics -----------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Brand name shown everywhere (pages, titles, manifest). Rename here.
APP_NAME=Hiyo
# Public URL, used for canonical/hreflang/social links. No trailing slash.
PUBLIC_URL=https://hiyo.example
# Shown on the Terms/Privacy pages.
CONTACT_EMAIL=support@hiyo.example
# Only these origins may open a chat connection (defaults to PUBLIC_URL).
# ALLOWED_ORIGINS=https://hiyo.example,https://www.hiyo.example

# --- accounts & sign-in -----------------------------------------------------------
# People must sign in (and accept the community guidelines once) before chatting.
# false = anonymous mode: only the 18+ guidelines dialog, remembered per browser.
REQUIRE_SIGN_IN=true
# "Continue with Google": an OAuth *Web application* client ID from Google Cloud
# Console (APIs & Services → Credentials). Add your site (and http://localhost:3000
# for testing) to its "Authorized JavaScript origins". No client secret is needed.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# Email + password accounts (no email verification yet — see README).
ALLOW_EMAIL_SIGNUP=true
# How long people stay signed in.
SESSION_DAYS=30
# Sign-in / sign-up attempts allowed per IP address per minute.
AUTH_ATTEMPTS_PER_MINUTE=10

# --- security & moderation ------------------------------------------------------
# Long random string. Signs sign-in cookies and hashes IP addresses — keep it
# stable and secret. If unset, one is generated and saved in DATA_DIR/.secret.
SERVER_SECRET=change-me-to-64-random-characters
# Enables /api/admin/* (reports, bans, accounts). Use a long random token.
ADMIN_TOKEN=
# Where users.json (accounts), bans.json and reports.jsonl are stored. Back it up.
DATA_DIR=./data
# Distinct reporters needed for an automatic ban, within this many minutes.
REPORT_THRESHOLD=3
REPORT_WINDOW_MINUTES=60
# Account & browser ban length / IP ban length (IP bans are short: many people share IPs).
BAN_HOURS=24
IP_BAN_HOURS=1
# Set to false where many users share one IP (carrier-grade NAT).
BAN_IP=true
# Refuse chat messages containing links (anti-spam).
BLOCK_LINKS=true
# Wait this long for someone with the same interests before matching randomly.
INTEREST_WAIT_MS=5000

# --- networking -------------------------------------------------------------------
# Which proxies to trust for X-Forwarded-For. Default trusts private networks
# (nginx/Caddy on the same host, Render, Fly, Heroku…). Set to 1 for one hop.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Behind Cloudflare (and firewalled to it)? Use its header for the real IP:
# CLIENT_IP_HEADER=cf-connecting-ip
CONNECTIONS_PER_MINUTE=120

# --- WebRTC: STUN / TURN -----------------------------------------------------------
# STUN works for most people; TURN is needed for strict NATs and many mobile
# networks. Pick ONE of the TURN options below.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Option A — your own coturn server with use-auth-secret (recommended):
# TURN_URLS=turn:turn.hiyo.example:3478?transport=udp,turn:turn.hiyo.example:3478?transport=tcp,turns:turn.hiyo.example:5349?transport=tcp
# TURN_SECRET=same-value-as-coturn-static-auth-secret

# Option B — any provider with fixed credentials:
# TURN_URLS=turn:relay.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Option C — Cloudflare Realtime TURN (global anycast network):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Lifetime of generated TURN credentials, in seconds.
TURN_TTL=43200
# Route ALL video through TURN so strangers never learn each other's IP
# (more private, but you pay for the bandwidth).
FORCE_RELAY=false
